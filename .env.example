# Gemini hybrid mode (optional). Set to "true" to let the chat assistant use
# Gemini for questions the built-in matcher can't answer. When unset or "false",
# the assistant stays fully offline and rule-based.
NEXT_PUBLIC_ENABLE_GEMINI=true

# Server-only. Get a free key at https://aistudio.google.com/apikey
# Without this, /api/chat returns 503 and the chat falls back to rule-based replies.
GEMINI_API_KEY=

# Optional model override (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite